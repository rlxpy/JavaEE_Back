<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.test1.mapper.PostLikeMapper">
    <select id="checkLike" resultType="java.lang.Integer">
        SELECT 1 FROM post_likes WHERE user_id = #{userId} AND post_id = #{postId} LIMIT 1
    </select>
    <insert id="addLike">
        INSERT INTO post_likes (user_id, post_id) VALUES (#{userId}, #{postId})
    </insert>
    <delete id="removeLike">
        DELETE FROM post_likes WHERE user_id = #{userId} AND post_id = #{postId}
    </delete>
</mapper>